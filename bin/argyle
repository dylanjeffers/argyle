#!/bin/sh
# Run Guile with argyle on the load path and its module syntax booted.
# With no args, starts a REPL with (argyle) loaded.
root="$(cd "$(dirname "$0")/.." && pwd)"

# Homebrew's guile doesn't search its own site dirs (where guile-fibers
# installs) unless told to.
if command -v brew >/dev/null 2>&1; then
  prefix="$(brew --prefix)"
  [ -d "$prefix/share/guile/site/3.0" ] &&
    GUILE_LOAD_PATH="$prefix/share/guile/site/3.0${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
  [ -d "$prefix/lib/guile/3.0/site-ccache" ] &&
    GUILE_LOAD_COMPILED_PATH="$prefix/lib/guile/3.0/site-ccache${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
  [ -d "$prefix/lib/guile/3.0/extensions" ] &&
    GUILE_SYSTEM_EXTENSIONS_PATH="$prefix/lib/guile/3.0/extensions${GUILE_SYSTEM_EXTENSIONS_PATH:+:$GUILE_SYSTEM_EXTENSIONS_PATH}"
  export GUILE_LOAD_PATH GUILE_LOAD_COMPILED_PATH GUILE_SYSTEM_EXTENSIONS_PATH
fi

if [ $# -eq 0 ]; then
  exec guile -L "$root" -l "$root/boot.scm" -e '(lambda _ (use-modules (argyle)) (set-current-module (resolve-module (quote (guile-user)))) ((@ (system repl repl) start-repl)))'
fi
exec guile -L "$root" -l "$root/boot.scm" "$@"
